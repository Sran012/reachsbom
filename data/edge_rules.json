{
  "log4j-shell": [
    {
      "type": "method_map",
      "sources": [
        "<org.apache.logging.log4j.Logger: void error(java.lang.String)>",
        "<org.apache.logging.log4j.Logger: void warn(java.lang.String)>",
        "<org.apache.logging.log4j.Logger: void info(java.lang.String)>"
      ],
      "targets": [
        "<org.apache.logging.log4j.core.lookup.JndiLookup: java.lang.String lookup(org.apache.logging.log4j.core.LogEvent,java.lang.String)>"
      ],
      "reason": "Log4j dispatches ${jndi:...} lookups through the plugin registry"
    }
  ]
}
