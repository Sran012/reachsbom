{
  "log4j-shell": [
    {
      "type": "method_map",
      "source_owner": "org.apache.logging.log4j.Logger",
      "source_names": [
        "error",
        "warn",
        "info",
        "debug",
        "trace",
        "fatal"
      ],
      "source_first_param": "java.lang.String",
      "targets": [
        "<org.apache.logging.log4j.core.lookup.JndiLookup: java.lang.String lookup(org.apache.logging.log4j.core.LogEvent,java.lang.String)>"
      ],
      "reason": "Application code logs a message through the Log4j API",
      "scope": "app"
    }
  ]
}
